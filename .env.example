DATABASE_URL=sqlite:///./data/app.db
INGEST_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-discovery-engine/0.1 by yourreddituser
YOUTUBE_API_KEY=

# Phase 2 — coding (Gemini on Render; Ollama only on your laptop if this is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional second provider — if both GEMINI_API_KEY and GROQ_API_KEY are set,
# Gemini is tried first and Groq is used as fallback on rate-limit errors
# (independent quota, different vendor).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# EXTRACT_STUB=1 uses a keyword coder (tests / no LLM)
# USE_MINILM=false skips sentence-transformers (hashing near-dup still runs)

# Phase 4 — Next.js (also copy into web/.env.local)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# web/.env.local needs INGEST_TOKEN= (same as above) for Refresh proxy

# Phase 5 — production
# DATABASE_URL=postgresql://…@….neon.tech/neondb?sslmode=require
# CORS_ORIGINS=https://your-app.vercel.app
# On Vercel: NEXT_PUBLIC_API_URL=https://your-api.onrender.com
